# Same content as `.env.example` (visible copy; dotfile may be hidden in some UIs).
# Copy to `.env` (untracked) and adjust. Do not commit real secrets.

# Redis for rate limiting (Docker Compose service name `redis`)
REDIS_URL=redis://redis:6379/0

RATE_LIMIT_ENABLED=true

# Fail open if Redis is unavailable (recommended for local dev)
RATE_LIMIT_FAIL_OPEN=true

# --- Browser CORS (local frontend → API on :8000)
# If CORS_ORIGINS is unset, the API allows exactly:
#   http://localhost:5173
#   http://127.0.0.1:5173
# If you set CORS_ORIGINS, it REPLACES those defaults — list every origin your browser may use
# (e.g. both localhost and 127.0.0.1, extra ports, or LAN IP for mobile testing).
# Example:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Route limits: requests per minute (numeric or "N/minute" form)
RATE_LIMIT_USERS_CREATE=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_USERS_BY_EMAIL=10/minute
RATE_LIMIT_JOBS_CREATE=20/minute
RATE_LIMIT_DEBUG_RUN=5/minute
RATE_LIMIT_RCA_RESULTS=60/minute
RATE_LIMIT_RCA_EXPLANATION=30/minute

# --- Email (verification / password reset)
# Where to set vars: create `.env` at the repository root (copy from `.env.example`). The API loads
# it via python-dotenv (`load_dotenv()` in `api/main.py`). Docker Compose can use `env_file: .env`.
# Never commit `.env` or real passwords/API keys.
#
# Switching providers:
#   EMAIL_PROVIDER=log    — local debugging; no outbound email; links in logs/stdout.
#   EMAIL_PROVIDER=smtp   — Gmail SMTP (example below) or other SMTP.
#   EMAIL_PROVIDER=resend — Resend HTTP API.
#
# --- Gmail SMTP (placeholders only; use an App Password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password


EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5173

#
# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=
#
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Optional rate limits for auth email endpoints (requests per minute)
RATE_LIMIT_AUTH_VERIFY_EMAIL=10/minute
RATE_LIMIT_AUTH_RESEND_VERIFICATION=10/minute
RATE_LIMIT_AUTH_FORGOT_PASSWORD=10/minute
RATE_LIMIT_AUTH_RESET_PASSWORD=10/minute

# --- JIRA (ticket ingestion for RCA entry flow)
# Placeholders only. Set real values in local `.env` or deployment secret manager.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_INVESTIGATION_STORE_DIR=/tmp/jira_rca_investigations
JIRA_INVESTIGATION_RETENTION_DAYS=14
