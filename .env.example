# Safe template — copy to `.env` (untracked) and adjust. Do not commit real secrets.

# Redis for rate limiting (Docker Compose service name `redis`)
REDIS_URL=redis://redis:6379/0

RATE_LIMIT_ENABLED=true

# Fail open if Redis is unavailable (recommended for local dev)
RATE_LIMIT_FAIL_OPEN=true

# Route limits: requests per minute (numeric or "N/minute" form)
RATE_LIMIT_USERS_CREATE=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_USERS_BY_EMAIL=10/minute
RATE_LIMIT_JOBS_CREATE=20/minute
RATE_LIMIT_DEBUG_RUN=5/minute
RATE_LIMIT_RCA_RESULTS=60/minute
RATE_LIMIT_RCA_EXPLANATION=30/minute

# --- Email (verification / password reset)
# Where to set vars: create `.env` at the repository root (copy this file). The API loads it via
# python-dotenv (`load_dotenv()` in `api/main.py`). Docker Compose can use `env_file: .env` or
# equivalent — never commit `.env` or real passwords/API keys.
#
# Switching providers:
#   EMAIL_PROVIDER=log    — local debugging only; no outbound email; links in logs/stdout
#                           (=== VERIFICATION EMAIL === / === PASSWORD RESET EMAIL ===).
#   EMAIL_PROVIDER=smtp   — real delivery via SMTP (Gmail: smtp.gmail.com:587 + STARTTLS + App Password).
#   EMAIL_PROVIDER=resend — real delivery via Resend API (requires verified domain or Resend onboarding).
#
# --- Gmail SMTP (placeholders only; use an App Password, not your normal Gmail password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password
#
# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=
#
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Optional rate limits for auth email endpoints (requests per minute)
RATE_LIMIT_AUTH_VERIFY_EMAIL=10/minute
RATE_LIMIT_AUTH_RESEND_VERIFICATION=10/minute
RATE_LIMIT_AUTH_FORGOT_PASSWORD=10/minute
RATE_LIMIT_AUTH_RESET_PASSWORD=10/minute
