DATADOG_DEFAULT_SERVICE=
DATADOG_LOOKBACK_MINUTES=60
DATADOG_CORRELATION_WINDOW_MINUTES=30
DATADOG_TIMEOUT_SEC=15
KUBERNETES_MCP_ENABLED=false
KUBERNETES_CONTEXT=
