# Copy to .env and adjust. docker-compose loads .env for the `api` service.

# --- Neo4j (must match docker-compose neo4j service if using compose network) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- Ollama (assistive agents: GraphRAG explanation, remediation, reporting) ---
# When the API runs in Docker, localhost:11434 points at the container itself, NOT the host.
# Point to Ollama on your machine:
#   macOS/Windows Docker Desktop: http://host.docker.internal:11434
#   Linux: use host-gateway (see docker-compose extra_hosts) with same URL
# Native uvicorn on host: http://127.0.0.1:11434 or http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Optional: force provider (default: ollama if OLLAMA_HOST set, else stub)
# GRAPHRAG_LLM_PROVIDER=ollama

# Optional second pass on explanation step (still grounded to deterministic RCA)
# DEBUG_AGENT_EXPLANATION_USE_LLM=true

# Optional: disable assistive LLM per stage
# REMEDIATION_USE_OLLAMA=false
# REPORTING_USE_OLLAMA=false
