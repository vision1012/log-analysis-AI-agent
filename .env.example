GITLAB_TIMEOUT_SEC=15
JENKINS_MCP_ENABLED=false
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB_NAME=
JENKINS_TIMEOUT_SEC=15
DATADOG_MCP_ENABLED=false
