# Log Analysis AI Agent - Environment Configuration
# Copy this file to .env and update values as needed

# ============================================================================
# Ollama Configuration
# ============================================================================
# Ollama API host URL
OLLAMA_HOST=http://localhost:11434

# Default Ollama model name (used when not specified in API request)
OLLAMA_MODEL=llama3

# ============================================================================
# Directory Configuration
# ============================================================================
# Directory for storing job records (JobStore)
# Jobs are stored in: RUNS_DIR/<job_id>/job.json
RUNS_DIR=runs

# Optional: Directory for log files
# If not set, log files are expected in the current working directory
# LOGS_DIR=/path/to/logs

# Optional: Directory for ChromaDB vector store
# If not set, defaults to output/indexes/
# CHROMA_DIR=/path/to/chromadb

# ============================================================================
# API Server Configuration
# ============================================================================
# API server host (default: 0.0.0.0 to accept connections from any interface)
API_HOST=0.0.0.0

# API server port (default: 8000)
API_PORT=8000

# ============================================================================
# Databases (local / Supabase-compatible Postgres + Neo4j jobs)
# ============================================================================
# PostgreSQL connection string (users table). Works with Supabase pooler URLs.
POSTGRES_URL=

# Neo4j (Bolt)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ============================================================================
# Notes
# ============================================================================
# - All paths can be absolute or relative to the project root
# - Boolean values: use "true"/"false" or "1"/"0"
# - Empty values use defaults defined in api/config.py
# - Copy this file to .env and fill in secrets; .env is typically gitignored
