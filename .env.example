INVESTIGATION_GRAPH_ENABLED=true
MCP_HEALTH_CACHE_SECONDS=300
MCP_RCA_SIGNALS_ENABLED=true
MCP_DEPLOYMENT_PROXIMITY_POINTS_0_5_MIN=12
MCP_DEPLOYMENT_PROXIMITY_POINTS_5_15_MIN=8
MCP_DEPLOYMENT_PROXIMITY_POINTS_15_30_MIN=4
